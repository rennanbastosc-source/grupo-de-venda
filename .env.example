NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Worker Baileys (processo separado — não roda na Vercel serverless)
WORKER_BASE_URL=http://127.0.0.1:3100
WORKER_API_SECRET=change-me

# Cron scrape (Authorization: Bearer … ou x-cron-secret)
CRON_SECRET=change-me-cron

# Opcional: SCRAPE_MOCK=1 para ofertas fake; SCRAPE_ML_URL / SCRAPE_AMAZON_URL
# SCRAPE_MOCK=1

# worker/.env
# PORT=3100
# WORKER_API_SECRET=change-me
# BAILEYS_AUTH_DIR=./data/auth
