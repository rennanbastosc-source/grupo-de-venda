NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Worker Baileys (processo long-running — não roda na Vercel serverless)
# Em prod: URL do Render/VPS (ex: https://seu-worker.onrender.com)
WORKER_BASE_URL=http://127.0.0.1:3100
# Mesmo valor no app e no worker
WORKER_API_SECRET=change-me

# Cron scrape/dispatch (Authorization: Bearer … ou x-cron-secret)
CRON_SECRET=change-me-cron

# Opcional: SCRAPE_MOCK=1 para ofertas fake; SCRAPE_ML_URL / SCRAPE_AMAZON_URL
# SCRAPE_MOCK=1

# Afiliados (server-only; templates usam se definidos)
# LIVELO_TAG=
# MELIUZ_PARTNER=

# --- worker/.env (processo Baileys) ---
# PORT=3100
# WORKER_API_SECRET=change-me
# Cifra das credenciais em wa_session_keys (obrigatório em prod):
#   openssl rand -base64 32
# WHATSAPP_SESSION_KEY=
# Supabase (mesmo projeto; service role para REST das keys):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fallback local sem WHATSAPP_SESSION_KEY:
# BAILEYS_AUTH_DIR=./data/auth
