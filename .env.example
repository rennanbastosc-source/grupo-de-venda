NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Worker Baileys (processo long-running — não roda na Vercel serverless)
# Em prod: URL do Render/VPS (ex: https://seu-worker.onrender.com)
WORKER_BASE_URL=http://127.0.0.1:3100
# Mesmo valor no app e no worker
WORKER_API_SECRET=change-me

# Cron scrape/dispatch (Authorization: Bearer … ou x-cron-secret)
CRON_SECRET=change-me-cron

# Opcional: SCRAPE_MOCK=1 para ofertas fake (CI/dev); FIRECRAWL_API_KEY em prod
# FIRECRAWL_API_KEY=fc-...
# SCRAPE_ML_URL=https://lista.mercadolivre.com.br/ofertas
# SCRAPE_AMAZON_URL=https://www.amazon.com.br/gp/bestsellers
# SCRAPE_SHOPEE_URL=https://shopee.com.br/flash_sale
# SCRAPE_MOCK=1

# Profile de browser do Firecrawl com sessão Shopee logada.
# A Shopee serve "Login Necessário" a toda navegação anônima de datacenter;
# sem este profile a fonte colhe zero. Criar com:
#   firecrawl scrape https://shopee.com.br/buyer/login --profile shopee-br
#   firecrawl interact "preencha e-mail e senha e clique em ENTRAR"
# FIRECRAWL_SHOPEE_PROFILE=shopee-br

# Autenticação Marketplace (server-only)
# ML_LOGIN=user@example.com
# ML_PASS=secret
# AMZN_LOGIN=user@example.com
# AMZN_PASS=secret
# SHOP_LOGIN=user@example.com
# SHOP_PASS=secret

# Afiliados (server-only; templates usam se definidos)
# LIVELO_TAG=
# MELIUZ_PARTNER=

# --- worker/.env (processo Baileys) ---
# PORT=3100
# WORKER_API_SECRET=change-me
# Cifra das credenciais em wa_session_keys (obrigatório em prod):
#   openssl rand -base64 32
# WHATSAPP_SESSION_KEY=
# Supabase (mesmo projeto; service role para REST das keys):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fallback local sem WHATSAPP_SESSION_KEY:
# BAILEYS_AUTH_DIR=./data/auth
